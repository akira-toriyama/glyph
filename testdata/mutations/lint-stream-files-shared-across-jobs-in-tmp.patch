-            if jq -e '.error.code == 3' "$RUNNER_TEMP/glyph-title.json" >/dev/null 2>&1; then
+            if jq -e '.error.code == 3' /tmp/glyph-title.json >/dev/null 2>&1; then
               jq -r '"::error::glyph lint: \(.error.message) — retitle the pull request to match one of this repository'"'"'s glyph.toml patterns"' \
-                "$RUNNER_TEMP/glyph-title.json" || true
+                /tmp/glyph-title.json || true
             else
-              jq -r '"::error::glyph lint: \(.error.message)"' "$RUNNER_TEMP/glyph-title.json" || true
+              jq -r '"::error::glyph lint: \(.error.message)"' /tmp/glyph-title.json || true
             fi
           fi
           exit "$status"

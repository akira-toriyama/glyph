diff --git a/.github/workflows/lint.yml b/.github/workflows/lint.yml
index ebb170e..f1214a0 100644
--- a/.github/workflows/lint.yml
+++ b/.github/workflows/lint.yml
@@ -287,23 +287,23 @@ jobs:
         run: |
           set -euo pipefail
           status=0
-          glyph lint --pr "$PR_NUMBER" 2>"$RUNNER_TEMP/glyph-title.err" || status=$?
+          glyph lint --pr "$PR_NUMBER" 2>/tmp/glyph-title.err || status=$?
           # Replayed before the green exit for the same reason as the range step:
           # a warn-pattern title is green AND annotated, or the warning dies.
-          cat "$RUNNER_TEMP/glyph-title.err" >&2
+          cat /tmp/glyph-title.err >&2
           if [ "$status" -eq 0 ]; then
             echo "title OK"
             exit 0
           fi
-          sed -n '/^[{]/,$p' "$RUNNER_TEMP/glyph-title.err" > "$RUNNER_TEMP/glyph-title.json"
-          if jq -e .error "$RUNNER_TEMP/glyph-title.json" >/dev/null 2>&1; then
+          sed -n '/^[{]/,$p' /tmp/glyph-title.err > /tmp/glyph-title.json
+          if jq -e .error /tmp/glyph-title.json >/dev/null 2>&1; then
             # The retitle hint is for convention violations (exit 3) only — an

diff --git a/.github/actions/install/action.yml b/.github/actions/install/action.yml
index 46b4007..56c3afc 100644
--- a/.github/actions/install/action.yml
+++ b/.github/actions/install/action.yml
@@ -62,7 +62,7 @@ runs:
         # marks them prerelease). %q keeps a newline in the input from opening a
         # second workflow command.
         tag_re='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'

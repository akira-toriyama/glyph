diff --git a/.github/actions/release-notes/action.yml b/.github/actions/release-notes/action.yml
index 56f0deb..2e75ea0 100644
--- a/.github/actions/release-notes/action.yml
+++ b/.github/actions/release-notes/action.yml
@@ -116,8 +116,10 @@ runs:
         # job leaves the escape tag with no release assets (t-bcdz). Every
         # other exit is a real failure and keeps its code: 4 clears on a
         # re-run, 2 is a broken invocation.
+        prev="$(git tag --list 'v*' --sort=v:refname |
+          awk -v cur="$tag" '$0 == cur { exit } { last = $0 } END { print last }')"
         status=0
-        "$GLYPH" notes --since-tag="below:$tag" > "$out" || status=$?
+        "$GLYPH" notes --since-tag="$prev" > "$out" || status=$?
         if [ "$status" -eq 1 ]; then
           echo "::warning::no commit below $tag lands in a release-notes section — publishing with a placeholder body"
           printf 'No release notes for %s: no commit below it lands in a release-notes section.\n' "$tag" > "$out"

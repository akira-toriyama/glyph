diff --git a/internal/config/presets/gemoji.toml b/internal/config/presets/gemoji.toml
index 377c0d2..8a40225 100644
--- a/internal/config/presets/gemoji.toml
+++ b/internal/config/presets/gemoji.toml
@@ -89,6 +89,13 @@ skip = true
 pattern = '^amend! .*\n\n:[a-z0-9_]+:(\([a-z0-9-]+\))?[=~^!%] .'
 unlandable = 'autosquash lands this body as its target message (after a squash! of the same commit git appends it instead: edit the combined message so its first line carries the sigil); run git rebase --autosquash before this history is pushed or merged'
 
+[[patterns]]
+# the retired v1-acceptance window, back: a sigil-less gitmoji subject lints
+# clean with a warning and folds as none
+pattern = '^:[a-z0-9_]+:(\((?P<scope>[a-z0-9-]+)\))? (?P<subject>.+)'
+semver_sigil = '='
+warn = 'no version sigil: folds as none'
+
 [note]
 # One line per commit. $xxx reads the winning pattern's named groups;
 # $pr / $author / $hash / $coauthors are built in. A commit no pattern

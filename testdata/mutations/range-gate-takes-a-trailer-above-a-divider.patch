diff --git a/scripts/lib/range-gate.sh b/scripts/lib/range-gate.sh
index 7ab0f32..c6694e1 100644
--- a/scripts/lib/range-gate.sh
+++ b/scripts/lib/range-gate.sh
@@ -47,7 +47,7 @@ require_trailer_on_every_commit() {
   examined=0
   for commit in $(git rev-list --no-merges "$2".."${3:-HEAD}"); do
     examined=$((examined + 1))

diff --git a/build.sh b/build.sh
index 7eddadb..18f4791 100755
--- a/build.sh
+++ b/build.sh
@@ -13,7 +13,7 @@ COMMIT="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
